# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & coverage
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js build artifacts
/.next/
/out/

# production
/build
/dist

# browser & temporary test profiles
/chrome_temp
/puppeteer_temp
*.tmp
*.bak
*.backup

# misc
.DS_Store
*.pem

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env & secret files
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# OS generated files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
.Spotlight-V100
